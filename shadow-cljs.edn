{:source-paths ["src" "test"]
 :dependencies [[reagent "1.3.0"] [org.babashka/sci "0.10.49"]]
 :dev-http {8080 "public"}
 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "js"
        :modules {:main {:init-fn sort-visualizer.core/init}}
        :devtools {:after-load sort-visualizer.core/render!}}
  :worker {:target :browser
           :output-dir "public/worker"
           :asset-path "worker"
           :modules {:worker {:init-fn sort-visualizer.worker/init :web-worker true}}}
  :test {:target :node-test
         :output-to "target/tests.js"
         :ns-regexp "-test$"
         :autorun true}}}
